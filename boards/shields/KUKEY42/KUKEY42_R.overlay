#include "KUKEY42.dtsi"
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

/ {
    // ボールを回したときの楕円 (縦横比と傾き) を真円に近づける補正。
    //   X' = (m11 * X + m12 * Y) / divisor
    //   Y' = (m21 * X + m22 * Y) / divisor
    // 軸ごとの倍率では傾きが取れないため、X と Y を混ぜる 2x2 行列にしている
    // (src/input_processor_xy_matrix.c)。値はトラックボール計測ページで出したものを入れる。
    // 経緯 (前のファーム X 1 倍 / Y 2 倍は「＼」に長かった):
    //   <1465 (-2252) (-1193) 3200> → 「／」に長い (補正がかかりすぎ)
    //   <1278 (-1662) (-864) 2688>  → まだ「／」
    //   <1209 (-1400) (-716) 2483>  → まだ「／」(計測で縦横比 2.17)
    //   → その計測で計測ページが出した値
    // 経緯の値と matrix は CPI 1000・divisor 1000 のときのもの。CPI を 2000 に上げたので、
    // divisor を 2000 にして補正の形と速さを保っている (縦は約 2 倍していたため 2 ずつ動いていたが、
    // 1 ずつ細かく動くようになる)
    trackball_matrix: trackball_matrix {
        compatible = "zmk,input-processor-xy-matrix";
        #input-processor-cells = <0>;
        matrix = <995 (-497) (-305) 2163>;
        divisor = <2000>;
    };

    // カーソルの加速 (zmk-input-processor-xy-accel)。LisM と同じ値。ボールを転がす速さ (カウント/秒) に
    // 応じて移動量に倍率 (1000 = 等倍) を掛ける。速さ 0 で min-factor、speed-threshold で等倍、
    // speed-max 以上で max-factor になり、その間は直線で補間する。ゆっくり動かしたときは
    // カーソルを細かく動かし、速く動かしたときは遠くまで動かす。
    // ゆっくり動かしたときに遅すぎれば min-factor を上げ、速く動かしたときに飛びすぎれば
    // (Windows の「ポインターの精度を高める」と重なるときなど) max-factor を下げる (1000 で加速なし)
    trackball_accel: trackball_accel {
        compatible = "zmk,input-processor-xy-accel";
        #input-processor-cells = <0>;
        min-factor = <500>;
        max-factor = <1300>;
        speed-threshold = <1000>;
        speed-max = <4000>;
    };

    // センサーの X/Y は trackball_matrix が止めて、補正後の値を trackball_matrix_listener に
    // 出し直す。こちらに残るのはスクロール (WHEEL / HWHEEL) だけ
    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&trackball_matrix>, <&zip_temp_layer 8 10000>;
    };

    // BLE で送るカーソルのレポートを、指定した ms に 1 回までにまとめる (USB 接続中は素通し)。
    // ドライバは 8ms ごと (CONFIG_PMW3610_POLLING_RATE_125_SW) に報告し、ZMK はその 1 回ごとに
    // レポートを 1 つ送る。ほかのキーボードも同じ PC に BLE でつないでいると、送信の機会が足りずに
    // レポートが溜まり (最大 20 個)、カーソルが遅れてまとめて動く。間隔に満たない X/Y は捨てずに
    // 次のレポートに足す (badjeff/zmk-input-processor-report-rate-limit)。
    // 値は 15: 8ms ごとの報告が 16ms ごと (AroundFortyRB と同じ) になる。時刻がミリ秒単位なので、
    // 16 にすると 16ms と 24ms が混ざる。まだカクつくときは 30 (32ms ごと) に上げる
    trackball_rate_limit: trackball_rate_limit {
        compatible = "zmk,input-processor-report-rate-limit";
        #input-processor-cells = <1>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
        limit-ble-only;
    };

    // 補正後の X/Y でカーソルを動かす。間隔をまとめるのは補正の後
    // (前にすると、trackball_matrix が組にして待つ X と Y がずれる)。
    // 加速は補正後の移動量で速さを測り、センサーの報告間隔 (8ms) のまま測るため、間隔をまとめる前に置く
    trackball_matrix_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball_matrix>;
        input-processors = <&trackball_accel>, <&trackball_rate_limit 15>, <&zip_temp_layer 8 10000>;
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        scroll-layers = <9>;
    };
};



// P を押したまま USB ケーブルを挿すと、ブートローダになる (src/usb_bootmagic.c)
/ {
    usb_bootmagic {
        compatible = "zmk,usb-bootmagic";
        row = <0>;
        column = <4>;
    };
};
